{
	"name": "typetorch-template",
	"version": "0.1.0",
	"private": true,
	"description": "TypeTorch starter game: Target Rush, a round-based minigame that hot-swaps mid-round, plus lobby coins. Shows every framework feature.",
	"license": "MIT",
	"scripts": {
		"build": "bun scripts/build-info.ts && rbxtsc",
		"compile": "rbxtsc",
		"payload": "bun run build && node -e \"require('fs').mkdirSync('build',{recursive:true})\" && rojo build default.project.json -o build/payload.rbxm",
		"watch": "bun scripts/build-info.ts && rbxtsc -w",
		"studio": "rojo serve studio.project.json",
		"test:analytics": "lune run scripts/test-analytics.luau",
		"typetorch": "typetorch",
		"packages": "bun scripts/packages.ts",
		"postinstall": "bun scripts/packages.ts --sync"
	},
	"dependencies": {
		"@rbxts/charm": "^0.11.1",
		"@rbxts/services": "^1.6.0",
		"@rbxts/t": "^3.2.1",
		"@rbxts/trove": "^1.3.0",
		"@typetorch/framework": "^0.5.0",
		"@typetorch/kernel": "^0.5.1",
		"rbxts-transform-debug": "2.2.0"
	},
	"devDependencies": {
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.956",
		"@typetorch/cli": "^0.9.1",
		"@typetorch/dev-server": "^0.2.3",
		"@typetorch/transformer": "^0.2.1",
		"roblox-ts": "^3.0.0",
		"typescript": "5.5.3"
	},
	"overrides": {
		"typescript": "5.5.3"
	}
}
